# ─────────────────────────────────────────
# QuickJobs User Service — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in the values
# NEVER commit your real .env file to GitHub

# PostgreSQL connection (matches docker-compose settings)
DATABASE_URL=postgresql://admin:password123@localhost:5432/quickjobs

# Redis connection (matches docker-compose settings)
REDIS_URL=redis://localhost:6379

# Service port
PORT=8001
